# LOOMOS Backend Environment Configuration
# Copy to .env for custom local overrides. Never commit real .env files.

LOOMOS_APP_NAME=LOOMOS
LOOMOS_DB_PATH=./data/loomos.db
LOOMOS_BACKUP_DIR=./data/backups
LOOMOS_UPLOAD_DIR=./data/uploads
LOOMOS_SECRET_KEY=replace-with-random-local-secret-or-leave-auto
LOOMOS_ACCESS_TOKEN_EXPIRE_MINUTES=720
LOOMOS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
