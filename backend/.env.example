# LOOMOS Backend Environment Configuration
# Copy to backend/.env for local overrides, or inject as Environment Variables in Google Antigravity Remote Agents.
# NEVER commit real .env files, JWT secrets, or API keys to GitHub.

LOOMOS_APP_NAME=LOOMOS
# Relative paths resolve against backend/ automatically:
LOOMOS_DB_PATH=./data/loomos.db
LOOMOS_DEMO_MODE=false
LOOMOS_BACKUP_DIR=./data/backups
LOOMOS_UPLOAD_DIR=./data/uploads

# Optional full SQLAlchemy URL override (leaves LOOMOS_DB_PATH active when blank):
LOOMOS_DATABASE_URL=

# Leave as placeholder or blank to auto-generate a persistent local 48-byte secret in backend/data/.jwt_secret:
LOOMOS_SECRET_KEY=replace-with-random-local-secret-or-leave-auto
LOOMOS_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Allow LAN, localhost, and cloud preview origins by default:
LOOMOS_CORS_ORIGINS=["*"]
# Serve built frontend/dist from FastAPI when true and frontend/dist exists:
LOOMOS_SERVE_STATIC=true

# Optional Gemini API integration (set via Antigravity Remote Agents environment secrets, never hardcode):
GEMINI_API_KEY=
LOOMOS_GEMINI_MODEL=gemini-2.5-flash

